# Absolute origin for sitemap, robots, and publish discovery URLs.
# Required on any public deploy (tunnel, Vercel, Render, Docker).
PUBLIC_ORIGIN=https://your-public-host.example.com

# Optional: override path to Ed25519 private key (default data/keys/ed25519.private.pem)
# QUOTUM_PRIVATE_KEY_PATH=/secure/ed25519.private.pem
