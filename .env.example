# Absolute origin for sitemap, robots, and publish discovery URLs.
# Required on any public deploy (tunnel, Vercel, Render, Docker).
PUBLIC_ORIGIN=https://your-public-host.example.com

# Optional: override path to Ed25519 private key (default data/keys/ed25519.private.pem)
# QUOTUM_PRIVATE_KEY_PATH=/secure/ed25519.private.pem

# Required on Vercel: PEM for the key that sealed data/sealed-contracts.json.
# Prefer the full PEM (newlines ok; literal \n also accepted).
# Without this, production must not invent a new keypair (breaks /verify).
# QUOTUM_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional override; otherwise public key is derived from the private key.
# QUOTUM_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional: durable attribution traffic on Vercel (Upstash Redis REST).
# Without these, hits fall back to filesystem (/tmp on Vercel — ephemeral).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
